# Dockerfile for backend_fastapi
# Uses Python slim image and installs native deps required by rembg, mediapipe and OpenCV.
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       libpq-dev \
       gcc \
       libffi-dev \
       libssl-dev \
       libgl1 \
       libglib2.0-0 \
       libsm6 \
       libxrender1 \
       libxext6 \
       ffmpeg \
       git \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY backend_fastapi/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy application code
COPY backend_fastapi/ /app/

EXPOSE 8000

# Default command (development). In production you may want different parameters.
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
